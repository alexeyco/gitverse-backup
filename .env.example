# GitVerse API token with repository read access.
GITVERSE_TOKEN=replace-with-gitverse-token

# Standard five-field cron expression and IANA timezone.
BACKUP_CRON=0 3 * * *
TZ=Europe/Moscow

# Yandex Disk REST API OAuth token and destination path.
YANDEX_DISK_OAUTH_TOKEN=replace-with-yandex-oauth-token
YANDEX_DISK_DESTINATION=disk:/backups/gitverse

# Number of completed cycle archives to retain.
BACKUP_RETENTION_COUNT=30
